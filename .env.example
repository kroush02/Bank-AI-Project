# Copy to .env and fill in locally. Never commit a real API key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Local runtime directory, relative to the working directory.
BANK_RUNTIME_DIR=runtime
# Maximum complete result size. Larger results fail; they are never silently truncated.
BANK_MAX_ROWS=10000
BANK_QUERY_TIMEOUT_SECONDS=5
